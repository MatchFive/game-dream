{
  "name": "gamedream",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs --run",
    "test:agent": "vitest run packages/cli/test/develop.test.ts packages/studio/test/agent.test.ts packages/studio/test/asset-agent.test.ts",
    "smoke:agent": "node scripts/studio-agent-smoke.mjs",
    "smoke:godot": "node scripts/godot-runtime-smoke.mjs",
    "smoke:godot-export": "node scripts/godot-export-smoke.mjs",
    "smoke:unity-release": "node scripts/unity-release-smoke.mjs",
    "typecheck": "corepack pnpm -r typecheck",
    "release:accept": "node scripts/release-acceptance.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
