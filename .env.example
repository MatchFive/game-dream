# Copy this file to .env and fill in your values.
# .env is gitignored; do not commit secrets.

# OpenAI-compatible chat/vision endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GAMEDREAM_MODEL=gpt-4o-mini
GAMEDREAM_VISION_MODEL=gpt-4o-mini
# Provider request timeout in milliseconds
GAMEDREAM_TIMEOUT_MS=120000

# Windows console executable, for example:
# GODOT_BIN=C:\path\to\Godot_v4.4.1-stable_win64_console.exe

# Local ComfyUI image generation
# COMFYUI_URL=http://192.168.124.56:8000
# COMFYUI_WORKFLOW=D:\QQ\image_qwen_image_2_1_t2i.json

# Optional Unity editor
# UNITY_BIN=D:\unity\6000.6.9f1\Editor
